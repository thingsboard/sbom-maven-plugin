<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.example.it</groupId>
        <artifactId>metadata</artifactId>
        <version>1.0</version>
    </parent>
    <artifactId>app</artifactId>
    <dependencies>
        <dependency>
            <groupId>org.example.it</groupId>
            <artifactId>ui</artifactId>
            <version>1.0</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>@cyclonedx-maven-plugin.version@</version>
                <executions>
                    <execution>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>makeBom</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <projectType>application</projectType>
                    <outputDirectory>${project.build.outputDirectory}/META-INF/sbom</outputDirectory>
                    <outputFormat>json</outputFormat>
                    <outputName>application.cdx</outputName>
                    <skipNotDeployed>false</skipNotDeployed>
                </configuration>
            </plugin>
            <plugin>
                <groupId>@project.groupId@</groupId>
                <artifactId>@project.artifactId@</artifactId>
                <version>@project.version@</version>
                <executions>
                    <execution>
                        <id>merge</id>
                        <goals>
                            <goal>merge</goal>
                        </goals>
                        <configuration>
                            <host>org.example.it:ui</host>
                        </configuration>
                    </execution>
                    <execution>
                        <id>metadata</id>
                        <goals>
                            <goal>metadata</goal>
                        </goals>
                        <configuration>
                            <manufacturer>
                                <name>Example, Inc.</name>
                                <urls>
                                    <url>https://example.org</url>
                                </urls>
                                <contacts>
                                    <contact>
                                        <email>security@example.org</email>
                                    </contact>
                                </contacts>
                            </manufacturer>
                            <supplier>
                                <name>Example, Inc.</name>
                            </supplier>
                            <componentManufacturer>
                                <name>Example, Inc.</name>
                                <urls>
                                    <url>https://example.org</url>
                                </urls>
                            </componentManufacturer>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
