<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.example.it</groupId>
    <artifactId>app</artifactId>
    <version>1.0</version>
    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
    </properties>
    <dependencies>
        <!-- A starter: Spring Boot leaves its jar out of the jar it packs -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
            <version>@spring-boot.version@</version>
        </dependency>
        <!-- Depends on jffi twice, as the plain jar and with the classifier native: two libraries with one group, name and version -->
        <dependency>
            <groupId>com.github.jnr</groupId>
            <artifactId>jnr-ffi</artifactId>
            <version>@jnr-ffi.version@</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>@cyclonedx-maven-plugin.version@</version>
                <executions>
                    <execution>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>makeBom</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <projectType>application</projectType>
                    <outputDirectory>${project.build.outputDirectory}/META-INF/sbom</outputDirectory>
                    <outputFormat>json</outputFormat>
                    <outputName>application.cdx</outputName>
                    <skipNotDeployed>false</skipNotDeployed>
                </configuration>
            </plugin>
            <!-- The jar and the Spring Boot jar are built before the package phase, so the SBOM is reconciled before anything packs the jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-jar</id>
                        <phase>prepare-package</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>@spring-boot.version@</version>
                <configuration>
                    <mainClass>org.example.it.App</mainClass>
                    <classifier>boot</classifier>
                    <executable>true</executable>
                </configuration>
                <executions>
                    <execution>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>@project.groupId@</groupId>
                <artifactId>@project.artifactId@</artifactId>
                <version>@project.version@</version>
                <executions>
                    <execution>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>reconcile</goal>
                        </goals>
                        <configuration>
                            <jar>${project.build.directory}/${project.build.finalName}-boot.jar</jar>
                            <otherJars>
                                <otherJar>${project.build.directory}/${project.build.finalName}.jar</otherJar>
                            </otherJars>
                            <libraries>
                                <library>
                                    <group>org.springframework.boot</group>
                                    <name>spring-boot-jarmode-tools</name>
                                    <license>Apache-2.0</license>
                                </library>
                            </libraries>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
